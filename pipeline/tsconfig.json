{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "@pipeline/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "../src/lib/types.ts"],
  "exclude": ["node_modules", "dist"]
}
